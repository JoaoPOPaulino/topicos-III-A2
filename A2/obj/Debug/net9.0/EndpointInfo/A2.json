  "components": {
    "schemas": {
      "DespesaCreateDto": {
        "required": [
          "categoriaId",
          "dataDespesa",
          "descricao",
          "moedaId",
          "valor"
        ],
        "type": "object",
        "properties": {
          "categoriaId": {
            "type": "integer",
            "format": "int32"
          },
          "fornecedorId": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "moedaId": {
            "type": "integer",
            "format": "int32"
          },
          "descricao": {
            "maxLength": 200,
            "minLength": 0,
            "type": "string"
          },
          "dataDespesa": {
            "type": "string",
            "format": "date-time"
          },
          "valor": {
            "maximum": 1.7976931348623157E+308,
            "minimum": 0.01,
            "type": "number",
            "format": "double"
          },
          "observacoes": {
            "type": "string",
            "nullable": true
          },
          "arquivosAnexados": {
            "type": "array",
