        "properties": {
          "colaboradorId": {
            "type": "integer",
            "format": "int32"
          },
          "departamentoId": {
            "type": "integer",
            "format": "int32"
          },
          "moedaId": {
            "type": "integer",
            "format": "int32"
          },
          "valor": {
            "maximum": 1.7976931348623157E+308,
            "minimum": 0.01,
            "type": "number",
            "format": "double"
          },
          "justificativa": {
            "maxLength": 500,
            "minLength": 10,
            "type": "string"
          },
          "dataPagamentoRequerida": {
            "type": "string",
            "format": "date-time"
          },
          "observacoes": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
